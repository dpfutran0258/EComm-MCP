{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3000"
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "AI": {
    "DefaultProvider": "OpenRouter",
    "OpenRouter": {
      "ApiKey": "",
      "Model": "nvidia/nemotron-3-ultra-550b-a55b:free",
      "BaseUrl": "https://openrouter.ai/api/v1",
      "MaxOutputTokens": 2048,
      "Temperature": 0.7,
      "TopP": 0.95,
      "TimeoutSeconds": 120,
      "EnableDetailedLogging": true
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}
